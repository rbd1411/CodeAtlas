# Browser-visible API base URL used by the web app.
NEXT_PUBLIC_CODEATLAS_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local-first defaults: no API key or external model is required.
CODEATLAS_EMBEDDING_PROVIDER=local
CODEATLAS_ANSWER_PROVIDER=local

# Optional OpenAI mode. Uncomment these and set OPENAI_API_KEY to enable it.
# OPENAI_API_KEY=your_api_key_here
# CODEATLAS_EMBEDDING_PROVIDER=openai
# CODEATLAS_EMBEDDING_MODEL=text-embedding-3-small
# CODEATLAS_ANSWER_PROVIDER=openai
# CODEATLAS_ANSWER_MODEL=gpt-5.4-mini

# Security and indexing limits.
# CODEATLAS_ALLOWED_REPO_ROOT=C:\work
CODEATLAS_MAX_FILE_BYTES=1000000
CODEATLAS_MAX_FILES=10000
CODEATLAS_MAX_TOTAL_BYTES=50000000
CODEATLAS_CHUNK_LINES=120
CODEATLAS_CHUNK_OVERLAP_LINES=12
CODEATLAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
